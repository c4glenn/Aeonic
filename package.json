{
  "name": "todo-tool",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @todo/api --filter @todo/web dev",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "db:migrate": "pnpm --filter @todo/api db:migrate",
    "client:generate": "pnpm --filter @todo/api openapi && pnpm --filter @todo/client generate",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
