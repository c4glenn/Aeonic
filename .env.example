# scrypt hash of your password. Generate with: pnpm --filter @aeonic/api hash-password '<password>'
# (the hash contains no `$`, so it is safe in Docker Compose and Portainer)
ADMIN_PASSWORD_HASH=
SESSION_SECRET=change-me-to-a-long-random-string
DATABASE_PATH=./data/aeonic.db
CORS_ORIGINS=http://localhost:5173
TZ=UTC
PORT=3000
# How often subscribed ICS calendars are re-downloaded (0 disables the background refresh)
ICS_REFRESH_MINUTES=30
