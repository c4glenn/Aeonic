# Argon2/scrypt hash produced by: pnpm --filter @todo/api hash-password '<password>'
ADMIN_PASSWORD_HASH=
SESSION_SECRET=change-me-to-a-long-random-string
DATABASE_PATH=./data/todo.db
CORS_ORIGINS=http://localhost:5173
TZ=UTC
PORT=3000
# How often subscribed ICS calendars are re-downloaded (0 disables the background refresh)
ICS_REFRESH_MINUTES=30
